Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Enabled: true
      Name: Grid
      Cell Size: 1
      Color: 160; 160; 164
      Line Style:
        Line Width: 0.03
        Value: Lines
      Plane: XY
      Plane Cell Count: 20
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
      Update Interval: 0
    - Class: rviz_default_plugins/Odometry
      Enabled: true
      Name: MAC-VO Odometry
      Topic:
        Value: /macvo/odometry
        Depth: 5
        Reliability Policy: System Default
      Keep: 10
      Shape:
        Value: Arrow
        Alpha: 1
        Color: 0; 255; 0
        Shaft Length: 0.15
        Shaft Radius: 0.02
        Head Length: 0.05
        Head Radius: 0.04
    - Class: rviz_default_plugins/Path
      Enabled: true
      Name: MAC-VO Path
      Topic:
        Value: /macvo/path
        Depth: 5
        Reliability Policy: System Default
      Color: 0; 255; 255
      Alpha: 1
      Line Style: Lines
      Line Width: 0.03
    - Class: rviz_default_plugins/PointCloud
      Enabled: true
      Name: MAC-VO Map Pointcloud
      Topic:
        Value: /macvo/map
        Depth: 5
        Reliability Policy: System Default
      Style: Points
      Size (m): 0.03
      Color Transformer: RGB8
    - Class: rviz_default_plugins/Image
      Enabled: true
      Name: Camera Left Raw
      Topic:
        Value: /camera/left/image_raw
        Depth: 5
        Reliability Policy: System Default
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: odom
    Frame Rate: 30
